# Copy to .env and fill in. Never commit real values.
# The worker needs the SERVICE ROLE key (it acts as the system, bypassing RLS).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- worker behavior -------------------------------------------------------
POLL_INTERVAL_MS=5000
WORK_DIR=/tmp/boxer-worker

# --- pipeline tuning --------------------------------------------------------
MAX_KEYFRAMES=16     # keyframes kept per analysis (motion-weighted)
EXTRACT_FPS=2        # candidate extraction rate before downselection
MIN_POSE_SCORE=0.3   # min mean keypoint score to accept a pose (0..1)
GUARD_DROP_THRESHOLD=0.35  # guard_height_proxy below this = guard-drop event

# --- Phase 2b ---------------------------------------------------------------
VISION_ENABLED=false  # true in 2b; then OPENAI_API_KEY is required
OPENAI_API_KEY=

# --- monetization (monthly limits; tier_1/tier_2 limits TBD by Derek) -------
FREE_MONTHLY_LIMIT=5
TIER_1_MONTHLY_LIMIT=50
TIER_2_MONTHLY_LIMIT=200

# --- binaries (defaults assume ffmpeg/ffprobe on PATH) ----------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
